type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    sourceAccountId: ID!
    targetAccountId: ID!
    amount: Float!
    currency: String!
}

type TransferResult {
    debit: Transaction!
    credit: Transaction!
}

type Query {
    transactions: [Transaction!]!
    transactionById(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): Transaction!
    transfer(input: TransferInput!): TransferResult!
}
